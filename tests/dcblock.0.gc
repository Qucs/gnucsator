load c_include.so
load d_trln.so
load d_dcblock.so
load s_sparam.so
load mgsim

`include ../include/sources.v
`include ../include/lumped.v

verilog

module main (\1 , \2 , \3 );
  ground gnd;
  Vac #(.U(1.)) v(\1 , \1a )
  Vdc #(.U(1.)) v(\1a , gnd )
  DCBlock #() d(\1 , \2 )
  resistor #(.r(1)) r(\2 , gnd )
endmodule // main

main #() m(\1 , \2 , \3 )

print dc v(m.d)
dc

print tran v(nodes)
tran 1

print ac vr(nodes) vp(nodes) vm(nodes)
ac 1e6 2e6 * {sqrt(2)}
