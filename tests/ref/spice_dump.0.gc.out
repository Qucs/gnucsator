(* spice_caneda="V%label %port{p} %port{n} DC %property{Va} AC %property{Va} 0 SIN( %property{Voff} %property{Va} %property{freq} %property{td} %property{theta} )" *) module vsine (.p(p),.n(n));
  parameter real Va = 1.;
  parameter real Voff = 0.;
  parameter real td = 0.;
  parameter real theta = 0.;
  parameter real freq = 10.;
  // behavioural model could go here.
  // analog begin
  //   if($analysis("ac"))
  //     V(p,n)<+ac_stim(...);
  //   else
  //     V(p,n)<+ sin(...)
  //   endif
  // end
endmodule // vsine

module my_schematic ();
  vsine #(.Va(5.),.Voff(0.),.td(0.),.theta(0.),.freq(3)) v (.p(a),.n(b));
  resistor #(.r(4k)) r1 (.p(a),.n(b));
  (* spice_caneda="Voverride somethingelse x y" *) vsine #(.Va(5.),.freq(3)) v (.p(a),.n(b));
endmodule // my_schematic

#          
 27.       
.model my_schematic  ( tnom=NA( 27.))
